# Copy to .env.local and fill in. Never commit .env.local.
# Without the two Supabase values the app runs in demo mode (in-memory data, dev only).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for file processing, upload links, quotas and deleting accounts. Never expose.
SUPABASE_SECRET_KEY=

# Public URL of the site, used in sign-in links (e.g. https://studynest.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# AI (flashcards, mindmaps). Server-only, free plans, no card needed.
# Leave GROQ_API_KEY empty to use the local stand-in generator (demo mode, CI).
# https://console.groq.com/keys
GROQ_API_KEY=
# Optional fallback when Groq is rate limited or down: Cloudflare dashboard → Workers AI
# (account ID, plus an API token with the "Workers AI" read permission).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# Shared secret so only this server can call the `embed` Edge Function (any long random string;
# set the same value with `supabase secrets set EMBED_FUNCTION_SECRET=...`).
EMBED_FUNCTION_SECRET=

# Set to 1 to allow demo mode in a production build (e.g. a Vercel preview without Supabase).
DEMO_MODE=
